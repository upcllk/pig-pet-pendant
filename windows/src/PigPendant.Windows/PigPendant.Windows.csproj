<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Version>0.2.0</Version>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../PigPendant.Core/PigPendant.Core.csproj" />
    <PackageReference Include="NAudio.Wasapi" Version="3.3.0" />
    <EmbeddedResource Include="../../../PigPendant/Resources/balloon.png;../../../PigPendant/Resources/bamboo-pig.png;../../../PigPendant/Resources/rope-pig.png;../../../PigPendant/Resources/net-pig-custom.png;../../../PigPendant/Resources/hanging-pig-custom.png;../../../PigPendant/Resources/ghost-blink.png;../../../PigPendant/Resources/ghost-halo.png" LogicalName="PigPendant.Resources.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../../PigPendant/Resources/status-pig-spin.gif" LogicalName="PigPendant.Resources.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../../PigPendant/Resources/default-settings.json" LogicalName="PigPendant.Resources.default-settings.json" />
    <EmbeddedResource Include="../../licenses/NAudio.txt" LogicalName="PigPendant.Licenses.NAudio.txt" />
  </ItemGroup>
</Project>
