<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../PigPendant.Core/PigPendant.Core.csproj" />
    <EmbeddedResource Include="../../../PigPendant/Resources/*.png" LogicalName="PigPendant.Resources.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../../PigPendant/Resources/*.gif" LogicalName="PigPendant.Resources.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
